# Demo and tests need no credentials. Use connect, or set BOTH values.
# Partial/blank overrides fail; keep actual values private.
# PINGROOM_TOKEN=your-robot-credential
# PINGROOM_ROOM=ROOMCODE1234
# Paths are relative to this project: proposals.json, config.json,
# .pingroom/credentials.json, .ranking/state.json, .ranking/report.json
